# mock | live. mock needs no API keys and no cloud services: fixture
# connector, rule-based extractor, deterministic hashed-token embeddings.
ORCHESTRATOR_MODE=mock

# Per-axis overrides of ORCHESTRATOR_MODE; "auto" follows it.
# CONNECTOR_FIXTURES=never runs the real connectors while extraction and
# embedding stay keyless -- how to check a parser against your own export
# without an LLM key.
CONNECTOR_FIXTURES=auto   # auto | never
EXTRACTOR=auto            # auto | mock | llm
EMBEDDER=auto             # auto | fake | real

ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=8090

# Rust gateway (Phase 1 stack; ./scripts/run_local.sh)
GATEWAY_URL=http://127.0.0.1:8080

NEO4J_URI=bolt://127.0.0.1:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=memoraidev
NEO4J_DATABASE=neo4j

REDIS_URL=redis://127.0.0.1:6380/0
INGESTION_QUEUE=memorai-ingestion

EMBEDDING_DIM=256

# Hybrid retrieval ranking (ADR 0003). The weights are ratios and are
# normalised, so a score is always in [0, 1] whatever values you use.
SEMANTIC_WEIGHT=0.6
RECENCY_WEIGHT=0.15
PROXIMITY_WEIGHT=0.25
# A real half-life now: recency_score() returns exactly 0.5 at this age. 180
# days rather than 30 because in a resolved record an old decision still
# stands until something supersedes it -- `supersedes` carries that signal,
# not the clock. The eval harness is what should move this number.
RECENCY_HALF_LIFE_DAYS=180

# Optional allow-list of source ids to ingest from, comma-separated. Empty
# (the default) means every connector registered in connectors/registry.py.
ENABLED_SOURCES=

# ChatGPT connector. There is no conversation-history API, so the only
# source is the user's own export: in ChatGPT, Settings -> Data controls ->
# Export data; OpenAI emails a .zip. Point this at a directory holding one
# export per owner, as <dir>/<owner_id>/conversations.json,
# <dir>/<owner_id>.json, <dir>/<owner_id>.zip, or <dir>/<owner_id>/*.zip
# (the .zip may be left exactly as it arrives). Unset means the connector
# fails with instructions; mock mode uses a bundled fixture export instead.
CHATGPT_EXPORT_DIR=

# Seal ChatGPT transcripts in the enclave before storage. Defaults to true
# and should stay true: a ChatGPT history is an undifferentiated stream of
# medical, legal, financial and work questions.
CHATGPT_SENSITIVE=true

# Only used when ORCHESTRATOR_MODE=live (or EXTRACTOR=llm).
#
# Extraction goes through an OpenAI-compatible /chat/completions API, so the
# vendor is a URL. Groq by default; OpenAI, Together or a local vLLM work by
# changing LLM_BASE_URL and the model name.
LLM_BASE_URL=https://api.groq.com/openai/v1
EXTRACTION_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECS=60

# GROQ_API_KEY is accepted as an alias. Prefer the environment; LLM_API_KEY_FILE
# is the fallback for a key sitting in a file next to the checkout, which is
# covered by .gitignore. Leave the file unset in a real deployment.
LLM_API_KEY=
LLM_API_KEY_FILE=api_key.txt

EMBEDDING_MODEL=voyage-3

# Encrypt the resolved record's text at rest (ADR 0010): an event's summary and
# body, a claim's statement, an entity's name and aliases, a citation's quote.
# Structure -- ids, timestamps, edges, ACL fields, claim status -- stays in the
# clear so the structural reads keep working, and embeddings do too until stage 2.
#
# The key never leaves the enclave, so every seal and unseal is a round trip
# through the gateway: set this only where a gateway is reachable and an owner
# session is available. There is no fallback -- with this on and the gateway down,
# ingestion fails rather than quietly writing plaintext.
#
# Off by default because the smoke script and the eval harness run without a
# gateway. A deployment holding real memory sets it.
ENCRYPT_CONTENT_AT_REST=false

# Where sealed ciphertext is written (ADR 0002). These bytes arrive already
# encrypted by the enclave, so this directory holds no plaintext -- but it
# holds the ONLY copy of a sensitive record's body, so put it somewhere that
# is backed up. Relative paths are relative to the working directory.
BLOB_STORE_DIR=.local/blobs

# When set, sealed blobs go to Walrus instead of BLOB_STORE_DIR. Still a stub:
# it raises rather than silently falling back to local disk, because a
# deployment that believes it writes to Walrus and actually writes here has a
# confidentiality bug, not a performance one.
WALRUS_PUBLISHER_URL=
WALRUS_AGGREGATOR_URL=

# There is deliberately no SEALED_TOKEN_STORE_URL here. The gateway's sealed
# OAuth refresh tokens are Postgres rows the orchestrator must never read;
# giving Python credentials for that database would defeat the point of
# doing the code exchange inside the enclave. See the README's
# "confidentiality model" section.
