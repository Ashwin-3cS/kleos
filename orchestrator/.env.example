# mock | live. mock needs no API keys and no cloud services: fixture
# connector, rule-based extractor, deterministic hashed-token embeddings.
ORCHESTRATOR_MODE=mock

# Per-axis overrides of ORCHESTRATOR_MODE; "auto" follows it.
# CONNECTOR_FIXTURES=never runs the real connectors while extraction and
# embedding stay keyless -- how to check a parser against your own export
# without an LLM key.
CONNECTOR_FIXTURES=auto   # auto | never
EXTRACTOR=auto            # auto | mock | llm
EMBEDDER=auto             # auto | fake | real

ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=8090

# Rust gateway (Phase 1 stack; ./scripts/run_local.sh)
GATEWAY_URL=http://127.0.0.1:8080

NEO4J_URI=bolt://127.0.0.1:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=memoraidev
NEO4J_DATABASE=neo4j

REDIS_URL=redis://127.0.0.1:6380/0
INGESTION_QUEUE=memorai-ingestion

EMBEDDING_DIM=256

# Optional allow-list of source ids to ingest from, comma-separated. Empty
# (the default) means every connector registered in connectors/registry.py.
ENABLED_SOURCES=

# ChatGPT connector. There is no conversation-history API, so the only
# source is the user's own export: in ChatGPT, Settings -> Data controls ->
# Export data; OpenAI emails a .zip. Point this at a directory holding one
# export per owner, as <dir>/<owner_id>/conversations.json,
# <dir>/<owner_id>.json, <dir>/<owner_id>.zip, or <dir>/<owner_id>/*.zip
# (the .zip may be left exactly as it arrives). Unset means the connector
# fails with instructions; mock mode uses a bundled fixture export instead.
CHATGPT_EXPORT_DIR=

# Seal ChatGPT transcripts in the enclave before storage. Defaults to true
# and should stay true: a ChatGPT history is an undifferentiated stream of
# medical, legal, financial and work questions.
CHATGPT_SENSITIVE=true

# Only used when ORCHESTRATOR_MODE=live
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-sonnet-5
EMBEDDING_MODEL=voyage-3

# Not wired yet (see README): encrypted raw content is carried inline
# instead of being written to Walrus.
WALRUS_PUBLISHER_URL=
WALRUS_AGGREGATOR_URL=

# There is deliberately no SEALED_TOKEN_STORE_URL here. The gateway's sealed
# OAuth refresh tokens are Postgres rows the orchestrator must never read;
# giving Python credentials for that database would defeat the point of
# doing the code exchange inside the enclave. See the README's
# "confidentiality model" section.
