# Enclave / VSOCK
ENCLAVE_CID=16
ENCLAVE_PORT=4000
LOG_PORT=5000
ENCLAVE_MODE=mock          # mock | nitro

# Gateway
GATEWAY_PORT=8080
ENCLAVE_HOST=127.0.0.1
SESSION_JWT_SECRET=
SESSION_TTL_SECS=3600

# Signs the OAuth `state` parameter. Deliberately separate from
# SESSION_JWT_SECRET; falls back to it when unset so local dev needs one
# value. The state token also carries typ=oauth_state, so a session token
# cannot be presented as a state (or vice versa).
OAUTH_STATE_SECRET=
OAUTH_STATE_TTL_SECS=600

# ---- OAuth apps ----
#
# Read this before filling it in. The client *ids* are public and belong to
# the gateway, which uses them to build the consent URL. The client
# *secrets* belong ONLY to the enclave's environment (baked into
# /enclave.env in the EIF, or this file in local mock mode, where the
# gateway and enclave share a process environment and neither uses them).
#
# Holding a client secret is what lets a party exchange an authorization
# code for a refresh token. The exchange happens inside the enclave
# precisely so the host cannot do it, and putting the secret in the
# gateway's environment on a real deployment would undo that.
#
# Redirect URI: register `<public gateway origin>/auth/callback` with both
# providers.
#
# Google consent needs access_type=offline + prompt=consent to return a
# refresh token at all; the gateway adds both. Scopes requested are in
# shared/src/oauth.rs: Google openid/email/gmail.readonly/calendar.readonly,
# GitHub read:user/repo.

# Gateway + enclave
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/auth/callback
GITHUB_REDIRECT_URI=http://127.0.0.1:8080/auth/callback

# Enclave ONLY
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_SECRET=

# Enclave-side outbound VSOCK tunnel ports (see run.sh / parent_forwarder.sh)
GOOGLE_OAUTH_VSOCK_PORT=8002
GITHUB_API_VSOCK_PORT=8003

# Path on each of those tunnels that serves the provider's token endpoint.
# Configurable because the host-side socat target decides which provider
# host the port actually reaches; see the note in README's Phase 2 section.
GOOGLE_TOKEN_PATH=/token
GITHUB_TOKEN_PATH=/login/oauth/access_token

# Postgres holding per-owner SEALED OAuth refresh tokens (ciphertext only;
# the gateway never has the plaintext). Unset => in-memory store, which is
# the local mock-mode default. The orchestrator is deliberately not given
# this URL: nothing in Python reads these rows.
SEALED_TOKEN_STORE_URL=postgres://memorai:memoraidev@127.0.0.1:5435/memorai

# Walrus (not wired yet, declared for later phases)
WALRUS_PUBLISHER_URL=
WALRUS_AGGREGATOR_URL=
WALRUS_MEMORY_RELAYER_URL=
WALRUS_MEMORY_NAMESPACE=

# Supabase (not wired yet)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- Phase 2: Python orchestration service (orchestrator/) ----
# The orchestrator reads these from orchestrator/.env; they are repeated
# here so the whole stack's configuration is visible in one place.
# See orchestrator/.env.example for the authoritative list.

ORCHESTRATOR_MODE=mock     # mock | live
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=8090

# Neo4j: the queryable memory index (entities, events, claims, embeddings).
NEO4J_URI=bolt://127.0.0.1:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=memoraidev
NEO4J_DATABASE=neo4j

# Redis: RQ ingestion job queue. Queries are synchronous and do not use it.
REDIS_URL=redis://127.0.0.1:6380/0
INGESTION_QUEUE=memorai-ingestion

# Must match the dimension of the Neo4j vector index created by
# orchestrator/storage/migrations.py.
EMBEDDING_DIM=256

# Only needed when ORCHESTRATOR_MODE=live.
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-sonnet-5
EMBEDDING_MODEL=voyage-3
